# --- Database ---
# Local zero-install default (works out of the box):
DATABASE_URL=sqlite:///./smartalloc.db
# Docker Compose / production Postgres:
# DATABASE_URL=postgresql+psycopg2://smartalloc:smartalloc@postgres:5432/smartalloc

# --- Redis (event stream). If unreachable the app falls back to an
# in-process async event bus automatically -- this is optional for local dev.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- LLM (optional) ---
# If unset, the Explanation Agent and Manager Agent NL parser use a fully
# deterministic offline fallback -- the app works completely without a key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Optimizer ---
SOLVER_TIME_LIMIT_SECONDS=12
TOP_K_CANDIDATES=20

# --- Demo ---
RANDOM_SEED=42
