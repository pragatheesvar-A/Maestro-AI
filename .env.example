# Root-level environment file used by docker-compose.yml.
# Copy to .env and adjust as needed: `cp .env.example .env`

# --- Postgres (docker-compose service) ---
POSTGRES_USER=smartalloc
POSTGRES_PASSWORD=smartalloc
POSTGRES_DB=smartalloc

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://smartalloc:smartalloc@postgres:5432/smartalloc
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-this-to-a-long-random-secret-in-production
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
